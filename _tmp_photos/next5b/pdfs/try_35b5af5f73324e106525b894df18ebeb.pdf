<script type="text/javascript">
  $(document).ready(function() {
    $('.popup-youtube, .popup-vimeo, .popup-gmaps').magnificPopup({
      disableOn: 700,
      type: 'iframe',
      mainClass: 'mfp-fade',
      removalDelay: 160,
      preloader: false,

      fixedContentPos: false
    });
  });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'))
        const menuOverlay = document.getElementById("main-nav-overlay");
        const activeClass = 'active';
        dropdownElementList.map(function (dropdownToggleEl) {
            if (dropdownToggleEl && (dropdownToggleEl.tagName === "BUTTON" || (dropdownToggleEl.tagName !== "BUTTON" && dropdownToggleEl.classList.contains('btn-menu-link')))) {
                dropdownToggleEl.addEventListener('show.bs.dropdown', function () {
                    menuOverlay.classList.add(activeClass);
                });
                dropdownToggleEl.addEventListener('hide.bs.dropdown', function () {
                    menuOverlay.classList.remove(activeClass);
                });
            }
        });

        const shareInput = document.getElementById("shareInputText");
        if (shareInput != null) {
            shareInput.addEventListener('click', function () {
                shareInput.focus();
                shareInput.select();
            });
        }
        /*function shareInputSelectText() {
            const input = document.getElementById('text-box');
            input.focus();
            input.select();
        }*/
    });
</script>
